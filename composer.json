{
    "name": "ilya-vasilyev/abelohost-blog",
    "description": "Блог на чистом PHP с категориями и статьями. Тестовое задание для AbeloHost.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ilya Vasilyev"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "scssphp/scssphp": "^1.12",
        "smarty/smarty": "^5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "database/migrations/",
            "database/seeders/"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "aliyun",
            "type": "composer",
            "url": "https://mirrors.aliyun.com/composer/"
        },
        {
            "name": "packagist",
            "type": "composer",
            "url": "https://mirrors.aliyun.com/composer/"
        }
        ]
}
