# Загруженные пользователем файлы
/public/uploads/*
!/public/uploads/.gitkeep

# Логи и кэш рантайма
/storage/logs/*.log
!/storage/logs/.gitkeep
/storage/smarty/

# IDE
.idea/
.vscode/
*.swp
*.swo

