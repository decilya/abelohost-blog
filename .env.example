# Основные настройки приложения
APP_NAME="AbeloHost Blog"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Подключение к MySQL.
# В Docker-окружении хост - имя сервиса из docker-compose.yml ("mysql").
DB_HOST=mysql
DB_PORT=3306
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
